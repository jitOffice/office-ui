{
  "name": "@jitoffice/ui",
  "version": "0.1.0",
  "description": "Office 交互外壳。根入口框架无关；Vue 组件在 ./vue 子路径。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitOffice/office-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/umd/office-ui.js",
  "jsdelivr": "./dist/umd/office-ui.js",
  "typesVersions": {
    "*": {
      "vue": [
        "./dist/types/vue/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/types/vue/index.d.ts",
        "default": "./dist/es/vue/index.js"
      },
      "require": {
        "types": "./dist/types/vue/index.d.cts",
        "default": "./dist/cjs/vue/index.cjs"
      }
    },
    "./style.css": "./dist/styles/office-ui.css",
    "./layered.css": "./dist/styles/office-ui.layered.css",
    "./es/*": "./dist/es/*",
    "./cjs/*": "./dist/cjs/*",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../internal/build/src/build.ts ui",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:unit": "vitest run --config vitest.config.ts --coverage",
    "test:visual": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --config vite.config.ts"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
