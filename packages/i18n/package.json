{
  "name": "@jitoffice/i18n",
  "version": "0.0.0",
  "description": "中英日繁四语包、消息语法与 Intl 封装。零运行时依赖，无框架。",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/umd/office-ui-i18n.js",
  "jsdelivr": "./dist/umd/office-ui-i18n.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./locales/zh-CN": {
      "types": "./dist/types/locales/zh-CN.d.ts",
      "import": "./dist/es/locales/zh-CN.js",
      "require": "./dist/cjs/locales/zh-CN.cjs"
    },
    "./locales/zh-TW": {
      "types": "./dist/types/locales/zh-TW.d.ts",
      "import": "./dist/es/locales/zh-TW.js",
      "require": "./dist/cjs/locales/zh-TW.cjs"
    },
    "./locales/ja-JP": {
      "types": "./dist/types/locales/ja-JP.d.ts",
      "import": "./dist/es/locales/ja-JP.js",
      "require": "./dist/cjs/locales/ja-JP.cjs"
    },
    "./locales/en-US": {
      "types": "./dist/types/locales/en-US.d.ts",
      "import": "./dist/es/locales/en-US.js",
      "require": "./dist/cjs/locales/en-US.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../internal/build/src/build.ts i18n",
    "keys:gen": "node scripts/gen-keys.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
