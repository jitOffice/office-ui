{
  "name": "@jitoffice/i18n",
  "version": "0.0.0",
  "description": "中英日繁四语包、消息语法与 Intl 封装。零运行时依赖，无框架。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitOffice/office-ui.git",
    "directory": "packages/i18n"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "locales/*": [
        "./dist/types/locales/*.d.ts"
      ]
    }
  },
  "unpkg": "./dist/umd/office-ui-i18n.js",
  "jsdelivr": "./dist/umd/office-ui-i18n.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./locales/zh-CN": {
      "import": {
        "types": "./dist/types/locales/zh-CN.d.ts",
        "default": "./dist/es/locales/zh-CN.js"
      },
      "require": {
        "types": "./dist/types/locales/zh-CN.d.cts",
        "default": "./dist/cjs/locales/zh-CN.cjs"
      }
    },
    "./locales/zh-TW": {
      "import": {
        "types": "./dist/types/locales/zh-TW.d.ts",
        "default": "./dist/es/locales/zh-TW.js"
      },
      "require": {
        "types": "./dist/types/locales/zh-TW.d.cts",
        "default": "./dist/cjs/locales/zh-TW.cjs"
      }
    },
    "./locales/ja-JP": {
      "import": {
        "types": "./dist/types/locales/ja-JP.d.ts",
        "default": "./dist/es/locales/ja-JP.js"
      },
      "require": {
        "types": "./dist/types/locales/ja-JP.d.cts",
        "default": "./dist/cjs/locales/ja-JP.cjs"
      }
    },
    "./locales/en-US": {
      "import": {
        "types": "./dist/types/locales/en-US.d.ts",
        "default": "./dist/es/locales/en-US.js"
      },
      "require": {
        "types": "./dist/types/locales/en-US.d.cts",
        "default": "./dist/cjs/locales/en-US.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../internal/build/src/build.ts i18n",
    "keys:gen": "node scripts/gen-keys.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
