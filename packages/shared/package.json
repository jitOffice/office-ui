{
  "name": "@jitoffice/shared",
  "version": "0.0.0",
  "description": "框架无关运行时（命令注册表等）。零运行时依赖，无框架。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitOffice/office-ui.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "commands": [
        "./dist/types/commands/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./commands": {
      "import": {
        "types": "./dist/types/commands/index.d.ts",
        "default": "./dist/es/commands/index.js"
      },
      "require": {
        "types": "./dist/types/commands/index.d.cts",
        "default": "./dist/cjs/commands/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../internal/build/src/build.ts shared",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
