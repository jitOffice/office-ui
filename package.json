{
  "name": "office-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Office/WPS-oriented Vue 3 component library — design phase.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "turbo run build",
    "build:check": "pnpm --filter @jitoffice/internal-build check",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:node": "node --test \"packages/*/test/**/*.test.ts\" \"docs/test/**/*.test.ts\" \"internal/test/**/*.test.ts\"",
    "test:unit": "turbo run test:unit",
    "test:visual": "turbo run test:visual",
    "size": "size-limit",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "node internal/scripts/check-contracts.ts",
    "lint:styles": "node internal/scripts/check-component-styles.ts",
    "lint:css-magic": "node internal/scripts/check-css-magic.ts",
    "lint:docs-offline": "node internal/scripts/check-docs-offline.ts",
    "lint:package": "node internal/scripts/check-package-artifacts.ts",
    "lint:changeset": "node internal/scripts/check-changeset.ts",
    "lint:types": "node internal/scripts/check-type-exports.ts",
    "lint:license": "node internal/scripts/check-licenses.ts",
    "lint:artifact-offline": "node internal/scripts/check-artifact-offline.ts",
    "lint:docs": "node docs/.vitepress/scripts/component-docs.ts --check && node docs/.vitepress/scripts/build-search-index.ts --check",
    "docs:gen": "node docs/.vitepress/scripts/component-docs.ts",
    "docs:search": "node docs/.vitepress/scripts/build-search-index.ts",
    "tokens:gen": "node packages/tokens/scripts/generate.ts",
    "i18n:gen": "node packages/i18n/scripts/gen-keys.ts",
    "icons:gen": "node packages/icons/scripts/generate.ts",
    "verify": "pnpm tokens:gen && pnpm i18n:gen && pnpm icons:gen && pnpm test:node && pnpm lint && pnpm lint:styles && pnpm lint:css-magic",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "node internal/scripts/clean.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "^3.0.3",
    "@size-limit/esbuild": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "nx": "24.0.0",
    "size-limit": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
