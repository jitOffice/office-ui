{
  "name": "office-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Office/WPS-oriented Vue 3 component library — design phase.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "turbo run build",
    "build:check": "pnpm --filter @jitoffice/internal-build check",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:node": "node --test \"packages/*/test/**/*.test.ts\"",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "node internal/scripts/check-contracts.ts",
    "tokens:gen": "node packages/tokens/scripts/generate.ts",
    "i18n:gen": "node packages/i18n/scripts/gen-keys.ts",
    "verify": "pnpm tokens:gen && pnpm i18n:gen && pnpm test:node && pnpm lint",
    "clean": "node internal/scripts/clean.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "nx": "24.0.0"
  }
}